js: ""

// 插件文件统一安装到 hiker://files/plugins/chaquopy/（与 PythonHiker.js 内部路径、
// DrpyHiker PyAdapter 的引用路径大小写保持一致，避免大小写敏感存储上找不到文件）
let libs = ["classes.dex", "chaquopy.apk", "arm64-v8a", "libs_py", "PythonHiker.js", "一键安装Python扩展.hkshell", "TestPythonHiker.hiker"];
let okCount = 0;
let failList = [];
for (let name of libs) {
    try {
        copyFiles(name, 'hiker://files/plugins/chaquopy/');
        okCount++;
    } catch (e) {
        failList.push(name);
    }
}
if (failList.length === 0) {
    toast("chaquopy 安装成功（" + okCount + " 项）");
} else {
    toast("安装完成 " + okCount + " 项，失败: " + failList.join("、") + "，请重试");
}